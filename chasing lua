local function setFly(on)
    FlyOn = on; local hrp = getHRP()
    if on and hrp then flyDesired = hrp.Position else flyDesired = nil end
    -- Включаем встроенный noclip для fly
    if on then
        local char = getChar()
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.CanTouch = false
                    p.CanQuery = false
                end
            end
        end
    end
end

local function updateFly(dt)
    if not FlyOn or not flyDesired then return end
    local hrp = getHRP(); if not hrp then return end
    if (hrp.Position - flyDesired).Magnitude > 30 then flyDesired = hrp.Position end
    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
    if dir.Magnitude > 0 then flyDesired = flyDesired + dir.Unit * FlySpeed * dt end
    local rot = hrp.CFrame - hrp.CFrame.Position
    hrp.CFrame = CFrame.new(flyDesired) * rot; hrp.Velocity = Vector3.zero
    -- Гарантируем noclip каждый кадр
    local char = getChar()
    if char then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if p.CanCollide then p.CanCollide = false end
                if p.CanTouch then p.CanTouch = false end
                if p.CanQuery then p.CanQuery = false end
            end
        end
    end
end

local function setNoClip(on)
    NoClipOn = on
    local char = getChar()
    if not char then return end
    if on then
        originalCollide = {}
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                originalCollide[p] = { Collide = p.CanCollide, Touch = p.CanTouch, Query = p.CanQuery }
                p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
            end
        end
    else
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") and originalCollide[p] then
                p.CanCollide = originalCollide[p].Collide
                p.CanTouch = originalCollide[p].Touch
                p.CanQuery = originalCollide[p].Query
            end
        end
        originalCollide = {}
        task.defer(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Velocity.Y < -50 then
                hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
            end
        end)
    end
end

