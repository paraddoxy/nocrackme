-- ============================================
local function setFreecam(on)
    FreecamOn = on
    if on then
        local hrp = getHRP()
        if hrp then
            freecamPos = hrp.Position + Vector3.new(0, 5, 0)
            -- Сохраняем текущий поворот камеры
            local cf = cam.CFrame
            freecamRotY = math.atan2(cf.LookVector.X, cf.LookVector.Z)
            freecamRotX = math.asin(math.clamp(cf.LookVector.Y, -1, 1))
        end
        savedCamSubject = cam.CameraSubject
        savedCamType = cam.CameraType
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CameraSubject = nil
    else
        cam.CameraType = savedCamType or Enum.CameraType.Custom
        local hum = getHumanoid()
        if hum then cam.CameraSubject = hum end
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end
end

local function updateFreecam(dt)
    if not FreecamOn then return end
    
    -- Мышь свободна когда меню открыто
    if menuOpen then
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    else
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    end
    
    local moveDir = Vector3.zero
    local lookVec = cam.CFrame.LookVector
    local rightVec = cam.CFrame.RightVector
    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + lookVec end
    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - lookVec end
    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - rightVec end
    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + rightVec end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.yAxis end
    if moveDir.Magnitude > 0 then
        freecamPos = freecamPos + moveDir.Unit * freecamSpeed * dt
    end
    
    -- Поворот только когда меню закрыто
    if not menuOpen then
        local delta = UIS:GetMouseDelta()
        -- Только горизонтальный (лево-право) и вертикальный (верх-низ) поворот
        -- Без крена (roll) - камера всегда ровная
        freecamRotY = freecamRotY - delta.X * 0.003
        freecamRotX = math.clamp(freecamRotX - delta.Y * 0.003, -math.rad(89), math.rad(89))
    end
    
    -- CFrame без крена - только Yaw (лево-право) и Pitch (верх-низ)
    cam.CFrame = CFrame.new(freecamPos) * CFrame.Angles(freecamRotX, freecamRotY, 0)
end

