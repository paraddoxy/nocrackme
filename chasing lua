local function addSliderCore(parent, posUD, sizeUD, min, max, def, cb)
    local container = Instance.new("Frame")
    container.Size = sizeUD; container.Position = posUD; container.BackgroundTransparency = 1; container.Parent = parent
    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 36, 1, 0); valueLbl.Position = UDim2.new(1, -36, 0, 0)
    valueLbl.BackgroundTransparency = 1; valueLbl.Text = tostring(def); valueLbl.TextColor3 = THEME.Accent
    valueLbl.Font = Enum.Font.Code; valueLbl.TextSize = 11; valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = container
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -40, 0, 5); bg.Position = UDim2.new(0, 0, 0.5, -2)
    bg.BackgroundColor3 = THEME.SliderBg; bg.BorderSizePixel = 1; bg.BorderColor3 = THEME.Border; bg.Parent = container
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0; fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local val = def; local dragging = false
    bg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local r = math.clamp((i.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(r, 0, 1, 0); val = math.floor(min + r * (max - min)); valueLbl.Text = tostring(val)
            if cb then cb(val) end
        end
    end)
end
