        keyFrame.Position = UDim2.new(keyPosStart.X.Scale, keyPosStart.X.Offset + (i.Position - keyDragStart).X, keyPosStart.Y.Scale, keyPosStart.Y.Offset + (i.Position - keyDragStart).Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then keyDrag = false end
end)

-- INPUT
UIS.JumpRequest:Connect(function() if JumpOn and not FlyOn and not FreecamOn then doJump() end end)
UIS.InputBegan:Connect(function(input, gp)
    if listeningBind then
        if input.KeyCode == Enum.KeyCode.Escape then
            assignBind(listeningBind, Enum.KeyCode.Unknown); listeningBind = nil; return
        end
        local newBind = nil
        if input.KeyCode ~= Enum.KeyCode.Unknown then newBind = input.KeyCode
        elseif input.UserInputType.Name:match("MouseButton") then newBind = input.UserInputType end
        if newBind then assignBind(listeningBind, newBind); listeningBind = nil end
        return
    end
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        menuOpen = not menuOpen; frame.Visible = menuOpen; return
    end
    if bindMatches(Binds.Fly, input) then
        FlyOn = not FlyOn; setFly(FlyOn); if flyUI then flyUI.Set(FlyOn) end; return
    elseif bindMatches(Binds.NoClip, input) then
        NoClipOn = not NoClipOn; setNoClip(NoClipOn); if ncUI then ncUI.Set(NoClipOn) end; return
    elseif bindMatches(Binds.TP, input) then
        if TPOn then teleportToMouse() end; return
    elseif bindMatches(Binds.Fullbright, input) then
        FullbrightOn = not FullbrightOn; setFullbright(FullbrightOn); return
    end
    if input.KeyCode == Enum.KeyCode.Space and JumpOn and not FlyOn and not FreecamOn then doJump() end
end)

-- RESPAWN
plr.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    flyDesired = nil; originalCollide = {}; killTarget = nil; baseWalk = nil; voidSafe = nil
    clearEsp(); task.wait(0.3)
    if PenisOn then buildPenis() end
    if currentOutfit ~= "None" then buildOutfit(currentOutfit) end
    if SpeedOn then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then baseWalk = hum.WalkSpeed end
    end
    if NoClipOn then setNoClip(true) end
    if FreecamOn then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end
end)

-- MAIN LOOP
RunService.RenderStepped:Connect(function(dt)
    if FreecamOn then
        updateFreecam(dt)
    else
        updateFly(dt)
    end
    if NoClipOn then updateNoClip() end
    updateTPKill()
    updateAntiVoid()

    local hum = getHumanoid()
    local hrp = getHRP()

    nearestHunterDist = math.huge
    if hrp then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= plr and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp and isHunter(p) then
                    local d = (phrp.Position - hrp.Position).Magnitude
                    if d < nearestHunterDist then nearestHunterDist = d end
                end
            end
        end
    end

    if hum and hrp and not FreecamOn then
        if JumpOn then
            pcall(function()
                if hum.JumpPower ~= JumpValue then
                    hum.JumpPower = JumpValue; hum.JumpHeight = JumpValue / 7
                end
            end)
        end
        if SpinOn and hum.MoveDirection.Magnitude < 0.1 then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(7), 0)
        end
        if SpeedOn then
            if baseWalk == nil then baseWalk = 16 end
            local moving = (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.S) or
                           UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D))
            if moving then
                if hum.WalkSpeed < SpeedValue then
                    hum.WalkSpeed = math.min(SpeedValue, hum.WalkSpeed + 0.8)
                end
            else
                if hum.WalkSpeed > baseWalk then
                    hum.WalkSpeed = math.max(baseWalk, hum.WalkSpeed - 2.0)
                end
            end
        end
    end

    frameCount = frameCount + 1
    if frameCount % 10 == 0 then
        if KeyListOn then refreshKeyList() end
        if AnimBreakerOn then updateAnimBreaker() end
    end
    if frameCount % 15 == 0 then
        if EspOn then updateEsp() end
    end
end)
