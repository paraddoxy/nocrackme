-- ESP (ИСПРАВЛЕНО: охотник всегда красный)
local function clearEsp()
    for p, d in pairs(espData) do
        pcall(function()
            if d.hl then d.hl:Destroy() end
            if d.bb then d.bb:Destroy() end
        end)
    end
    espData = {}
end
local function updateEsp()
    if not EspOn then return end
    local myHRP = getHRP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not (hum and hum.Health > 0) then
                if espData[p] then
                    pcall(function()
                        if espData[p].hl then espData[p].hl:Destroy() end
                        if espData[p].bb then espData[p].bb:Destroy() end
                    end)
                    espData[p] = nil
                end
            else
                local d = espData[p]
                if not d then
                    local hl = Instance.new("Highlight")
                    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = char; hl.Parent = char
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 140, 0, 24); bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.AlwaysOnTop = true; bb.Adornee = hrp or char; bb.Parent = char
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1
                    tl.Font = Enum.Font.Code; tl.TextSize = 12; tl.TextStrokeTransparency = 0.2
                    tl.Parent = bb
                    d = {hl = hl, bb = bb, tl = tl}; espData[p] = d
                end
                if d.hl.Adornee ~= char then d.hl.Adornee = char; d.hl.Parent = char end
                if hrp and d.bb.Adornee ~= hrp then d.bb.Adornee = hrp end
                
                -- ПРОВЕРКА ОХОТНИКА КАЖДЫЙ КАДР ОБНОВЛЕНИЯ ESP
                local hunter = isHunter(p)
                local col
                if hunter then
                    col = Color3.fromRGB(255, 0, 0) -- Ярко-красный для охотника
                else
                    col = Color3.fromRGB(255, 255, 255) -- Белый для остальных
                end
                d.hl.FillColor = col
                d.hl.OutlineColor = col
                d.tl.TextColor3 = col
                
                local distText = ""
                if myHRP and hrp then distText = " [" .. math.floor((myHRP.Position - hrp.Position).Magnitude) .. "m]" end
                local tagText = hunter and " [HUNTER]" or ""
                d.tl.Text = p.Name .. distText .. tagText
            end
        end
    end
    for p, d in pairs(espData) do
        if not p.Character or not Players:FindFirstChild(p.Name) then
            pcall(function()
                if d.hl then d.hl:Destroy() end
                if d.bb then d.bb:Destroy() end
            end)
            espData[p] = nil
        end
    end
end
local function toggleEsp(on)
    EspOn = on
    if not on then clearEsp() end
end

-- ANTI VOID
local function updateAntiVoid()
    local hrp = getHRP(); local hum = getHumanoid(); if not hrp then return end
    local vel = hrp.Velocity
    if hum and hum.FloorMaterial ~= Enum.Material.Air and math.abs(vel.Y) < 20 then voidSafe = hrp.Position end
    if voidSafe and vel.Y < -20 then
        local rp = RaycastParams.new(); rp.FilterDescendantsInstances = {plr.Character}; rp.FilterType = Enum.RaycastFilterType.Exclude
        local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -150, 0), rp)
        if not hit then
            hrp.CFrame = CFrame.new(voidSafe + Vector3.new(0, 3, 0)); hrp.Velocity = Vector3.zero
            if FlyOn then flyDesired = hrp.Position end
        end
    end
end

